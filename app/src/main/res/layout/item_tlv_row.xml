<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="#1E293B"
    app:strokeWidth="1dp"
    app:strokeColor="#334155">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtTagCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TAG"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace"/>

        <TextView
            android:id="@+id/txtTagName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Name Descriptor"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtTagValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Value Hex Data"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
